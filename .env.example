# Copy to .env.local and enter actual values only when those services are ready.
JARVIS_MODEL=qwen3:0.6b
# Optional: use a different already-installed local model for planning tools.
# JARVIS_TOOL_MODEL=qwen3:0.6b
JARVIS_TIMEZONE=America/Chicago
# Pocket remains loaded for five minutes; increase only if memory permits.
# JARVIS_VOICE_IDLE_MS=300000
# JARVIS_HA_URL=http://homeassistant.local:8123
# JARVIS_HA_TOKEN=enter_your_token_here_in_this_local_file_only
# The TV receiver stays off until you explicitly set a local bind address.
# JARVIS_DISPLAY_BIND=192.168.1.100
# JARVIS_DISPLAY_PORT=3211
